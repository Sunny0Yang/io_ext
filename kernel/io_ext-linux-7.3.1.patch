+int d2fq_set_weight(struct blk_mq_hw_ctx *hctx, unsigned adj);
+int d2fq_set_weight(struct blk_mq_hw_ctx *hctx, unsigned adj)
+{
+	struct nvme_queue *nvmeq = hctx->driver_data;
+	struct nvme_ctrl *ctrl = &nvmeq->dev->ctrl;
