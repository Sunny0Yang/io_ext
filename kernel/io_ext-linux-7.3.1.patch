+static struct blkcg_policy scx_io_blkcg_policy = {
+	.pd_alloc_fn = scx_io_pd_alloc,
+	.pd_init_fn = scx_io_pd_init,
+	.pd_offline_fn = scx_io_pd_offline,
+	.pd_free_fn = scx_io_pd_free,
+};
