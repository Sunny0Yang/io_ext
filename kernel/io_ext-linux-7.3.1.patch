+	unsigned set_id = raw_smp_processor_id() / nr_q;
+	struct d2fq_data *dd;
+
+	if (q->d2fq_en == false)
+		return cpu;
+
+	dd = d2fq_assign_dd(q->dgd);
+	if (!dd)
+		return cpu;
+
+	cls = __d2fq_start_request(dd);
+	if (cls <= 0)
+		return cpu;
+	return nr_q*set_id + cls - 1;
+}
+#endif
+
 static inline struct blk_mq_ctx *__blk_mq_get_ctx(struct request_queue *q,
 					   unsigned int cpu)
 {
+#if defined(CONFIG_IOSCHED_D2FQ)
+	/* select queue to send request for shared queue env.
+	 * d2fq_force_all (declared deviation 4) bypasses the O_D2FQ task
+	 * election for the rig. */
+	if (q->d2fq_en && (current->flags & PF_D2FQ || sysctl_d2fq_force_all))
+		return per_cpu_ptr(q->queue_ctx,
+				   blk_mq_d2fq_set_request_class(q, cpu));
+	else
+#endif
 	return per_cpu_ptr(q->queue_ctx, cpu);
 }
 
