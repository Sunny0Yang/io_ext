+
+static bool iosched_arbiter_is_valid_access(int off, int size,
+					    enum bpf_access_type type,
+					    const struct bpf_prog *prog,
+					    struct bpf_insn_access_aux *info)
+{
+	u32 member_idx;
+
+	if (type != BPF_READ)
+		return false;
+	if (off % size != 0)
+		return false;
+	if (size != sizeof(u64))
+		return false;
+
+	member_idx = prog->expected_attach_type;
+	switch (member_idx) {
+	case 0:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_arbiter_dispatch_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	case 1:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_arbiter_dispatch_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	case 2:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_completed_request_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	case 3:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_inserted_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	case 4:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_dispatched_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	case 5:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_dispatch_failed_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	case 6:
+		if (off == 0) {
+			info->reg_type = PTR_TO_BTF_ID | PTR_TRUSTED;
+			info->btf = bpf_get_btf_vmlinux();
+			info->btf_id = btf_find_by_name_kind(info->btf,
+						     "iosched_dispatched_ctx",
+						     BTF_KIND_STRUCT);
+			return info->btf_id > 0;
+		}
+		return false;
+	default:
+		return false;
+	}
+}
+
+static const struct bpf_verifier_ops iosched_arbiter_verifier_ops = {
+	.get_func_proto = iosched_bpf_get_func_proto,
+	.is_valid_access = iosched_arbiter_is_valid_access,
+	.btf_struct_access = iosched_bpf_btf_struct_access,
+};
+
+static struct bpf_struct_ops iosched_arbiter_bpf_ops __used = {
+	.verifier_ops = &iosched_arbiter_verifier_ops,
+	.init         = iosched_bpf_init,
+	.check_member = iosched_bpf_check_member,
+	.init_member  = iosched_bpf_init_member,
+	.reg          = iosched_arbiter_reg,
+	.unreg        = iosched_arbiter_unreg,
+	.name         = "iosched_arbiter_ops",
+	.owner        = THIS_MODULE,
+	.cfi_stubs    = &arbiter_cfi_stubs,
+};
+
+static struct elevator_type scx_io_elevator = {
+	.ops = {
+		.init_sched       = scx_io_init_sched,
+		.exit_sched       = scx_io_exit_sched,
+		.prepare_switch   = scx_io_prepare_switch,
+		.init_hctx        = scx_io_init_hctx,
+		.exit_hctx        = scx_io_exit_hctx,
+		.alloc_sched_data = scx_io_alloc_sched_data,
+		.free_sched_data  = scx_io_free_sched_data,
+		.allow_merge      = scx_io_allow_merge,
+		.bio_merge        = scx_io_bio_merge,
+		.bio_should_bypass = scx_io_bio_bypass,
+		.request_merge    = scx_io_request_merge,
+		.request_merged   = scx_io_request_merged,
+		.requests_merged  = scx_io_requests_merged,
+		.limit_depth      = scx_io_limit_depth,
+		.depth_updated    = scx_io_depth_updated,
+		.prepare_request  = scx_io_prepare_request,
+		.finish_request   = scx_io_finish_request,
+		.insert_requests  = scx_io_insert_requests,
+		.dispatch_request = scx_io_dispatch_request,
+		.requeue_request  = scx_io_requeue_request,
+		.has_work         = scx_io_has_work,
+		.completed_request = scx_io_completed_request,
+		.former_request   = scx_io_former_request,
+		.next_request     = scx_io_next_request,
+		.init_icq         = scx_io_init_icq,
+		.exit_icq         = scx_io_exit_icq,
+	},
+	.icq_size = sizeof(struct io_cq),
+	.icq_align = __alignof__(struct io_cq),
+	.elevator_name = "scx_io",
+	.elevator_owner = THIS_MODULE,
+};
+
+int __init iosched_ext_init(void)
+{
+	int ret;
+
+	scx_io_teardown_wq = alloc_workqueue("scx_io_teardown",
+					     WQ_UNBOUND | WQ_MEM_RECLAIM,
+					     0);
+	if (!scx_io_teardown_wq)
+		return -ENOMEM;
+
+	ret = blkcg_policy_register(&scx_io_blkcg_policy);
+	if (ret)
+		goto out_destroy_wq;
+
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_STRUCT_OPS,
+					 &scx_io_kfunc_set);
+	if (ret)
+		goto out_blkcg_policy_unreg;
+
+	ret = elv_register(&scx_io_elevator);
+	if (ret) {
+		goto out_blkcg_policy_unreg;
+	}
+
+	ret = register_bpf_struct_ops(&iosched_ext_bpf_ops, iosched_ext_ops);
+	if (ret)
+		goto out_elv_unreg;
+
+	ret = register_bpf_struct_ops(&iosched_arbiter_bpf_ops, iosched_arbiter_ops);
+	if (ret)
+		goto out_elv_unreg;
+
+	ioext_dbg_pr_info("'scx_io' elevator registered successfully\n");
+	ioext_dbg_pr_info("BPF struct_ops ready\n");
+	return 0;
+
+out_elv_unreg:
+	elv_unregister(&scx_io_elevator);
+	out_blkcg_policy_unreg:
+	blkcg_policy_unregister(&scx_io_blkcg_policy);
+	out_destroy_wq:
+	destroy_workqueue(scx_io_teardown_wq);
+	scx_io_teardown_wq = NULL;
+	return ret;
+}
+
+static void __exit iosched_ext_exit(void)
+{
+	flush_workqueue(scx_io_teardown_wq);
+	destroy_workqueue(scx_io_teardown_wq);
+	scx_io_teardown_wq = NULL;
+	elv_unregister(&scx_io_elevator);
+	blkcg_policy_unregister(&scx_io_blkcg_policy);
+}
+
+module_init(iosched_ext_init);
+module_exit(iosched_ext_exit);
diff --git a/block/iosched_ext.h b/block/iosched_ext.h
new file mode 100644
index 000000000..000000000
--- /dev/null
+++ b/block/iosched_ext.h
@@ -0,0 +1,335 @@
+/* block/iosched_ext.h - Wrapper Struct Pattern for BPF struct_ops */
+#ifndef _IOSCHED_EXT_H
+#define _IOSCHED_EXT_H
+
+#include <linux/blk-mq.h>
+#include <linux/list.h>
+#include <linux/hashtable.h>
+#include <linux/spinlock.h>
+#include <linux/atomic.h>
+
+/*
+ * Kernel-side data structures for BPF
+ */
+
+/* Request node in a list */
+struct iosched_request_node {
+    struct request *rq;
+    struct list_head node;
+};
+
+/* Request list */
+struct iosched_request_list {
+    struct list_head head;
+    struct hlist_node h_node;  /* For registry */
+    u64 list_id;
+    spinlock_t lock;
+};
+
+/* Data structure registry */
+#define IOSCHED_DS_REGISTRY_BITS 8
+struct iosched_ds_registry {
+    DECLARE_HASHTABLE(ds_hash, IOSCHED_DS_REGISTRY_BITS);
+    rwlock_t lock;
+    atomic64_t next_id;
+};
+
+/* Registry management functions */
+void iosched_ds_registry_init(struct iosched_ds_registry *registry);
+void iosched_ds_registry_cleanup(struct iosched_ds_registry *registry);
+
+/*
+ * Context structures for BPF struct_ops
+ */
+
+/*
+ * BPF Context Structure for insert_request
+ * 
+ * CRITICAL: This is a WRAPPER STRUCT used for BPF struct_ops.
+ * BPF programs access parameters via ctx->field, not separate registers.
+ * This is required because struct_ops passes all params via R1 offset.
+ */
+struct iosched_insert_ctx {
+    struct request_queue *q;
+    struct request *rq;
+    u64 icq_ptr;
+    u64 insert_flags;
+    u64 opf;
+    u64 sector;
+    u64 nr_sectors;
+    u64 cgroup_id;
+    u64 original_cgroup_id;
+    u64 ioprio;
+    u64 hctx_idx;
+};
+
+struct iosched_arbiter_dispatch_ctx {
+    struct request_queue *q;
+    u64 hctx_idx;
+    u64 cgroup_id;
+};
+
+struct iosched_hctx_ctx {
+	struct request_queue *q;
+	struct blk_mq_hw_ctx *hctx;
+	u64 hctx_idx;
+};
+
+struct iosched_icq_ctx {
+	struct request_queue *q;
+	struct io_cq *icq;
+};
+
+struct iosched_allow_merge_ctx {
+    struct request_queue *q;
+    struct request *rq;
+    struct bio *bio;
+    u64 rq_ioprio;
+    u64 bio_ioprio;
+    u64 rq_sector;
+    u64 rq_nr_sectors;
+    u64 bio_sector;
+    u64 bio_nr_sectors;
+    u64 bio_opf;
+    u64 rq_opf;
+};
+
+struct iosched_bio_merge_ctx {
+	struct request_queue *q;
+	struct bio *bio;
+	u64 nr_segs;
+	u64 bio_ioprio;
+	u64 bio_sector;
+	u64 bio_nr_sectors;
+	u64 bio_opf;
+};
+
+struct iosched_request_merge_ctx {
+	struct request_queue *q;
+	struct request *rq;
+	struct bio *bio;
+	u64 rq_ioprio;
+	u64 bio_ioprio;
+	u64 rq_sector;
+	u64 rq_nr_sectors;
+	u64 bio_sector;
+	u64 bio_nr_sectors;
+	u64 bio_opf;
+};
+
+struct iosched_request_merged_ctx {
+	struct request_queue *q;
+	struct request *rq;
+	u64 merge_type;
+	u64 rq_ioprio;
+	u64 rq_deadline;
+	u64 rq_sector;
+	u64 rq_nr_sectors;
+};
+
+struct iosched_requests_merged_ctx {
+	struct request_queue *q;
+	struct request *rq;
+	struct request *next;
+	u64 rq_ioprio;
+	u64 next_ioprio;
+	u64 rq_deadline;
+	u64 next_deadline;
+	u64 rq_sector;
+	u64 rq_nr_sectors;
+	u64 next_sector;
+	u64 next_nr_sectors;
+};
+
+struct iosched_limit_depth_ctx {
+	struct request_queue *q;
+	struct blk_mq_alloc_data *data;
+	u64 icq_ptr;
+	u64 ioprio;
+	u64 opf;
+	u64 hctx_idx;
+	u64 async_depth;
+};
+
+struct iosched_depth_updated_ctx {
+	struct request_queue *q;
+	u64 nr_requests;
+	u64 async_depth;
+};
+
+struct iosched_rq_ctx {
+	struct request_queue *q;
+	struct request *rq;
+	u64 icq_ptr;
+	u64 ioprio;
+	u64 opf;
+	u64 sector;
+	u64 nr_sectors;
+	u64 hctx_idx;
+};
+
+struct iosched_completed_request_ctx {
+	struct request_queue *q;
+	struct request *rq;
+	u64 icq_ptr;
+	u64 ioprio;
+	u64 opf;
+	u64 sector;
+	u64 nr_sectors;
+	u64 hctx_idx;
+	u64 cgroup_id;
+	u64 now;
+	u64 total_latency_ns;
+	u64 io_latency_ns;
+};
+
+struct iosched_inserted_ctx {
+	u64 rq_ptr;
+	u64 policy_cgroup_id;
+	u64 original_cgroup_id;
+	u64 hctx_idx;
+	u64 opf;
+	u64 ioprio;
+	u64 nr_sectors;
+	u64 flags;
+};
+
+struct iosched_dispatched_ctx {
+	u64 rq_ptr;
+	u64 selected_cgroup_id;
+	u64 policy_cgroup_id;
+	u64 original_cgroup_id;
+	u64 hctx_idx;
+	u64 opf;
+	u64 ioprio;
+	u64 nr_sectors;
+	u64 flags;
+	/*
+	 * Request-identity key: the hctx the request was allocated on
+	 * (rq->mq_hctx->queue_num).  Identity counters (pending/inflight)
+	 * must be keyed by this so that inserted_request (which fires with
+	 * the request's home hctx) pairs exactly with dispatched_request,
+	 * completed_request and requeue_refund even when a per-cgroup
+	 * shared local-policy queue is popped by a different hctx's
+	 * dispatch loop.  hctx_idx remains the decision/accounting key
+	 * (dispatching hctx for dispatched_request; the charged key stashed
+	 * in elv.priv[1] for requeue_refund).
+	 */
+	u64 home_hctx_idx;
+};
+
+struct iosched_dispatch_failed_ctx {
+	u64 selected_cgroup_id;
+	u64 hctx_idx;
+	u64 reason;
+};
+
+/*
+ * BPF Context Structure for init/exit_queue
+ */
+struct iosched_queue_ctx {
+    struct request_queue *q;
+};
+
+#define IOSCHED_BYPASS_MODE_NONE   0ULL
+#define IOSCHED_BYPASS_MODE_DIRECT 1ULL
+
+#define IOSCHED_ARB_ALLOW_FALLBACK  0ULL
+#define IOSCHED_ARB_STRICT         1ULL
+
+/* 
+ * The operations struct for BPF struct_ops
+ * All multi-param functions use wrapper struct as single param
+ */
+struct iosched_ext_ops {
+    /* Called when scheduler is initialized */
+    int (*init_queue)(struct iosched_queue_ctx *ctx);
+    
+    /* Called when scheduler is unloaded */
+    int (*exit_queue)(struct iosched_queue_ctx *ctx);
+    
+	/* Core: Insert request into queue (push to BPF Map) */
+	int (*insert_request)(struct iosched_insert_ctx *ctx);
+
+	u64 (*cgroup_dispatch)(struct iosched_arbiter_dispatch_ctx *ctx);
+
+	u64 (*evacuate)(struct iosched_arbiter_dispatch_ctx *ctx);
+
+	int (*init_hctx)(struct iosched_hctx_ctx *ctx);
+
+	void (*exit_hctx)(struct iosched_hctx_ctx *ctx);
+
+	bool (*allow_merge)(struct iosched_allow_merge_ctx *ctx);
+
+	bool (*bio_merge)(struct iosched_bio_merge_ctx *ctx);
+
+	u64 (*request_merge)(struct iosched_request_merge_ctx *ctx);
+
+	void (*request_merged)(struct iosched_request_merged_ctx *ctx);
+
+	void (*requests_merged)(struct iosched_requests_merged_ctx *ctx);
+
+	u64 (*limit_depth)(struct iosched_limit_depth_ctx *ctx);
+
+	void (*depth_updated)(struct iosched_depth_updated_ctx *ctx);
+
+	void (*prepare_request)(struct iosched_rq_ctx *ctx);
+
+	void (*finish_request)(struct iosched_rq_ctx *ctx);
+
+	void (*completed_request)(struct iosched_completed_request_ctx *ctx);
+
+	void (*requeue_request)(struct iosched_rq_ctx *ctx);
+
+	u64 (*former_request)(struct iosched_rq_ctx *ctx);
+
+	u64 (*next_request)(struct iosched_rq_ctx *ctx);
+
+	void (*init_icq)(struct iosched_icq_ctx *ctx);
+
+	void (*exit_icq)(struct iosched_icq_ctx *ctx);
+
+	u64 bypass_mode;
+
+	/* Name to identify different BPF schedulers */
+	char name[16];
+};
+
+struct iosched_arbiter_ops {
+    u64 (*pick_cgroup)(struct iosched_arbiter_dispatch_ctx *ctx);
+
+    bool (*hold_dispatch)(struct iosched_arbiter_dispatch_ctx *ctx);
+
+    void (*completed_request)(struct iosched_completed_request_ctx *ctx);
+
+    void (*inserted_request)(struct iosched_inserted_ctx *ctx);
+
+    void (*dispatched_request)(struct iosched_dispatched_ctx *ctx);
+
+    void (*dispatch_failed)(struct iosched_dispatch_failed_ctx *ctx);
+
+    void (*requeue_refund)(struct iosched_dispatched_ctx *ctx);
+
+    u64 arb_mode;
+
+    char name[16];
+};
+
+
+/*
+ * Wrapper struct for BPF struct_ops registration
+ * This MUST be defined for libbpf to find the struct_ops type in BTF.
+ */
+#ifdef __KERNEL__
+#include <linux/bpf.h>
+
+struct bpf_struct_ops_iosched_ext_ops {
+    struct bpf_struct_ops_common_value common;
+    struct iosched_ext_ops data;
+};
+#endif /* __KERNEL__ */
+
+bool scx_io_bio_should_bypass(struct request_queue *q, struct bio *bio);
+
+int iosched_ext_init(void);
+#endif /* _IOSCHED_EXT_H */
diff --git a/drivers/nvme/host/core.c b/drivers/nvme/host/core.c
index 000000000..000000000 100644
--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -2807,6 +2807,15 @@ int nvme_enable_ctrl(struct nvme_ctrl *ctrl)
 	ctrl->ctrl_config &= ~NVME_CC_CRIME;
 
 	ctrl->ctrl_config |= (NVME_CTRL_PAGE_SHIFT - 12) << NVME_CC_MPS_SHIFT;
+#ifdef CONFIG_IOSCHED_D2FQ
+	/* D2FQ (reference core.c): enable WRRU arbitration when the
+	 * controller advertises AMS=WRRU, so SQ priority classes and the
+	 * arbitration feature calls take effect. */
+	if (NVME_CAP_AMS(ctrl->cap) == 0x1) {
+		dev_info(ctrl->device, "d2fq: WRRU arbitration supported\n");
+		ctrl->ctrl_config |= NVME_CC_AMS_WRRU | NVME_CC_SHN_NONE;
+	} else
+#endif
 	ctrl->ctrl_config |= NVME_CC_AMS_RR | NVME_CC_SHN_NONE;
 	ctrl->ctrl_config |= NVME_CC_IOSQES | NVME_CC_IOCQES;
 	ret = ctrl->ops->reg_write32(ctrl, NVME_REG_CC, ctrl->ctrl_config);
diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 000000000..000000000 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -30,6 +30,9 @@
 
 #include "trace.h"
 #include "nvme.h"
+#ifdef CONFIG_IOSCHED_D2FQ
+#include <linux/d2fq.h>
+#endif
 
 #define SQ_SIZE(q)	((q)->q_depth << (q)->sqes)
 #define CQ_SIZE(q)	((q)->q_depth * sizeof(struct nvme_completion))
@@ -1788,6 +1791,42 @@ static int adapter_alloc_sq(struct nvme_dev *dev, u16 qid,
 	struct nvme_command c = { };
 	int flags = NVME_QUEUE_PHYS_CONTIG;
 
+#ifdef CONFIG_IOSCHED_D2FQ
+	/* D2FQ (reference adapter_alloc_sq, non-MULTISQ variant): rotate a
+	 * WRR priority class over the I/O submission queues so that the
+	 * block-layer class remap picks an SQ whose priority matches the
+	 * classified class (HIGH/MEDIUM/LOW; the class-to-qid indexing line
+	 * in blk_mq_d2fq_set_request_class is aligned with this rotation).
+	 * Only effective while CC.AMS == WRRU. */
+	if (ctrl->ctrl_config & NVME_CC_AMS_WRRU) {
+		unsigned nr_sets_per_node =
+			((num_possible_cpus() / num_possible_nodes()) / 3);
+		unsigned nr_q = (num_possible_cpus() / num_possible_nodes()) /
+				nr_sets_per_node;
+		unsigned sq_class;
+
+		if (nvmeq->qid == 0) {
+			flags |= NVME_SQ_PRIO_URGENT;
+			goto sq_flags_done;
+		}
+		if (nr_sets_per_node > 0) {
+			sq_class = ((nvmeq->qid - 1) % nr_q) + 1;
+
+			switch (sq_class) {
+			case D2FQ_CLS_HIGH:	flags |= NVME_SQ_PRIO_HIGH;	break;
+			case D2FQ_CLS_MEDIUM:	flags |= NVME_SQ_PRIO_MEDIUM;	break;
+			case D2FQ_CLS_LOW:	flags |= NVME_SQ_PRIO_LOW;	break;
+			default:		flags |= NVME_SQ_PRIO_MEDIUM;	break;
+			}
+			dev_info(ctrl->device, "d2fq: qid:%3u sq_class:%u\n",
