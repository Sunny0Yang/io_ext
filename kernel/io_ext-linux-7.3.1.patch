+static int iosched_bpf_init(struct btf *btf)
+{
+	s32 type_id;
+
+	type_id = btf_find_by_name_kind(btf, "iosched_insert_ctx", BTF_KIND_STRUCT);
+	if (type_id < 0)
+		return -EINVAL;
