@@ -0,0 +1,95 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+
+KSFT_PASS=0
+KSFT_FAIL=1
+
+self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+src="${IOSCHED_EXT_SRC:-$self_dir/../../../../block/iosched_ext.c}"
+
+if [ ! -r "$src" ]; then
+	echo "1..1"
+	echo "not ok 1 iosched_ext.c is readable"
+	exit "$KSFT_FAIL"
+fi
+
+awk '
+BEGIN {
+	print "1..1"
+}
+
+/^static struct blkcg_gq \*scx_io_policy_find_blkg\(/ {
+	in_find = 1
+}
+in_find && /blkg = ref->blkg;/ {
+	find_assigns_blkg = 1
+	find_needs_get = 1
+}
+in_find && find_needs_get && /blkg_get\(blkg\);/ {
+	find_gets_blkg = 1
+}
+in_find && /break;/ {
+	if (find_assigns_blkg && find_gets_blkg)
+		find_get_before_break = 1
+}
+in_find && /spin_unlock_irqrestore\(&policy->lock, irq_flags\);/ {
+	if (find_gets_blkg)
+		find_get_before_unlock = 1
+}
+in_find && /return blkg;/ {
+	find_returns_blkg = 1
+}
+in_find && /^}/ {
+	in_find = 0
+}
+
+/^static void scx_io_note_quiesced_dispatch\(/ {
+	in_dispatch = 1
+}
+in_dispatch && /bool lookup_blkg = false;/ {
+	dispatch_tracks_lookup_path = 1
+}
+in_dispatch && /if \(!blkg\)/ {
+	dispatch_checks_blkg = 1
+}
+in_dispatch && dispatch_checks_blkg && /return;/ {
+	dispatch_returns_on_null_blkg = 1
+}
+in_dispatch && /if \(lookup_blkg\)/ {
+	dispatch_guards_next_put = 1
+}
+in_dispatch && /blkg_put\(blkg\);/ {
+	dispatch_puts_blkg = 1
+	if (dispatch_guards_next_put)
+		dispatch_put_guarded_by_lookup = 1
+	else
+		dispatch_puts_unconditionally = 1
+	dispatch_guards_next_put = 0
+}
+in_dispatch && /^}/ {
+	in_dispatch = 0
+}
+
+END {
+	if (find_assigns_blkg && find_gets_blkg && find_get_before_break &&
+	    find_get_before_unlock && find_returns_blkg && dispatch_puts_blkg &&
+	    dispatch_puts_unconditionally && !dispatch_put_guarded_by_lookup &&
+	    dispatch_returns_on_null_blkg) {
+		print "ok 1 policy find blkg returns referenced blkg and dispatch releases it"
+		exit 0
+	}
+
+	print "not ok 1 policy find blkg returns referenced blkg and dispatch releases it"
+	if (!find_assigns_blkg || !find_returns_blkg)
+		print "# scx_io_policy_find_blkg does not return a found blkg"
+	if (!find_gets_blkg || !find_get_before_break || !find_get_before_unlock)
+		print "# scx_io_policy_find_blkg does not blkg_get() the found blkg before unlocking"
+	if (!dispatch_puts_blkg)
+		print "# scx_io_note_quiesced_dispatch does not blkg_put() a non-NULL blkg"
+	if (dispatch_put_guarded_by_lookup || !dispatch_puts_unconditionally)
+		print "# scx_io_note_quiesced_dispatch only blkg_put()s the fallback lookup path"
+	if (!dispatch_returns_on_null_blkg)
+		print "# scx_io_note_quiesced_dispatch does not preserve the NULL blkg return path"
+	exit 1
+}
+' "$src"
diff --git a/tools/testing/selftests/iosched_ext/offline_teardown_capture.sh b/tools/testing/selftests/iosched_ext/offline_teardown_capture.sh
new file mode 100755
index 000000000..000000000
--- /dev/null
+++ b/tools/testing/selftests/iosched_ext/offline_teardown_capture.sh
@@ -0,0 +1,171 @@
+#!/bin/sh
+
+KSFT_PASS=0
+KSFT_FAIL=1
+
+self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+src="${IOSCHED_EXT_SRC:-$self_dir/../../../../block/iosched_ext.c}"
+
+if [ ! -r "$src" ]; then
+	echo "1..3"
+	echo "not ok 1 iosched_ext.c is readable"
+	echo "not ok 2 iosched_ext.c is readable"
+	echo "not ok 3 iosched_ext.c is readable"
+	exit "$KSFT_FAIL"
+fi
+
+awk '
+function count_open_braces(str, tmp)
+{
+	tmp = str;
+	return gsub(/\{/, "{", tmp);
+}
+
+function count_close_braces(str, tmp)
+{
+	tmp = str;
+	return gsub(/\}/, "}", tmp);
+}
+
+BEGIN {
+	print "1..3";
+}
+
+/^static int scx_io_policy_capture_blkgs\(/ {
+	in_capture = 1;
+	capture_depth = 0;
+}
+
+in_capture {
+	if (/\{/)
+		seen_capture_body = 1;
+	capture_depth += count_open_braces($0);
+	capture_depth -= count_close_braces($0);
+}
+
+in_capture && /spin_unlock_irqrestore\(&blkcg->lock/ {
+	after_blkcg_unlock = 1;
+}
+
+in_capture && after_blkcg_unlock && /if \(ret\)/ {
+	ret_guard_after_unlock = 1;
+}
+
+in_capture && after_blkcg_unlock && ret_guard_after_unlock && /scx_io_policy_drop_blkg_refs\(policy\);/ {
+	drops_refs_after_partial_capture = 1;
+}
+
+in_capture && seen_capture_body && capture_depth == 0 {
+	in_capture = 0;
+}
+
+/^#define[[:space:]]+SCX_IO_MAX_EVAC_HCTX[[:space:]]+/ {
+	max_hctx = $3;
+	sub(/U$/, "", max_hctx);
+	if (max_hctx + 0 >= 4096)
+		hctx_cap_covers_nvme = 1;
+}
+
+/^static noinline int scx_io_policy_prepare_teardown\(/ {
+	in_prepare = 1;
+}
+
+in_prepare && /if \(reason == SCX_IO_RETIRE_OFFLINE && offline_blkg\) \{/ {
+	seen_offline_blkg = 1;
+	in_offline_blkg = 1;
+	offline_blkg_depth = 0;
+}
+
+in_prepare && in_offline_blkg {
+	offline_blkg_depth += count_open_braces($0);
+	offline_blkg_depth -= count_close_braces($0);
+	if (offline_blkg_depth == 0) {
+		in_offline_blkg = 0;
+		after_offline_blkg = 1;
+	}
+}
+
+in_prepare && /if \(reason == SCX_IO_RETIRE_OFFLINE\)/ && !/&& offline_blkg/ {
+	null_offline_return_guard = 1;
+}
+
+in_prepare && null_offline_return_guard && /return 0;/ {
+	null_offline_early_return = 1;
+}
+
+in_prepare && after_offline_blkg && !capture_seen && /return 0;/ {
+	offline_blkg_early_return = 1;
+}
+
+in_prepare && /ret = scx_io_policy_capture_blkgs\(policy\);/ {
+	capture_seen = 1;
+	if (after_offline_blkg)
+		capture_after_offline_blkg = 1;
+}
+
+in_prepare && /^}/ {
+	in_prepare = 0;
+}
+
+/^static noinline void scx_io_policy_teardown_workfn\(/ {
+	in_teardown = 1;
+}
+
+in_teardown && /for \(i = 0; i < SCX_IO_MAX_EVAC_HCTX; i\+\+\) \{/ {
+	fallback_uses_hctx_cap = 1;
+	in_hctx_fallback = 1;
+}
+
+in_teardown && in_hctx_fallback && /scx_io_policy_evacuate_hctx\(policy, NULL, i\)/ {
+	fallback_evacuates_null_queue = 1;
+}
+
+in_teardown && in_hctx_fallback && /^\t\t\t}/ {
+	in_hctx_fallback = 0;
+}
+
+in_teardown && /^}/ {
+	in_teardown = 0;
+}
+
+END {
+	pass1 = seen_offline_blkg && capture_after_offline_blkg &&
+		!offline_blkg_early_return && !null_offline_early_return;
+	pass2 = hctx_cap_covers_nvme && fallback_uses_hctx_cap &&
+		fallback_evacuates_null_queue;
+	pass3 = !drops_refs_after_partial_capture;
+
+	if (pass1)
+		print "ok 1 offline teardown captures offline blkg then all remaining blkgs";
+	else {
+		print "not ok 1 offline teardown captures offline blkg then all remaining blkgs";
+		if (!seen_offline_blkg)
+			print "# offline_blkg preservation block was not found";
+		if (!capture_after_offline_blkg)
+			print "# scx_io_policy_capture_blkgs does not run after offline_blkg handling";
+		if (offline_blkg_early_return)
+			print "# offline_blkg path still returns before global blkg capture";
+		if (null_offline_early_return)
+			print "# offline NULL-blkg path still returns before global blkg capture";
+	}
+
+	if (pass2)
+		print "ok 2 teardown fallback scans hctx indices beyond 255";
+	else {
+		print "not ok 2 teardown fallback scans hctx indices beyond 255";
+		if (!hctx_cap_covers_nvme)
+			print "# SCX_IO_MAX_EVAC_HCTX is below 4096";
+		if (!fallback_uses_hctx_cap || !fallback_evacuates_null_queue)
+			print "# teardown fallback hctx scan was not found";
+	}
+
+	if (pass3)
+		print "ok 3 capture_blkgs keeps partial blkg refs on allocation failure";
+	else {
+		print "not ok 3 capture_blkgs keeps partial blkg refs on allocation failure";
+		print "# scx_io_policy_capture_blkgs drops captured refs after blkcg unlock";
+	}
+
+	exit (pass1 && pass2 && pass3) ? 0 : 1;
+}
+' "$src"
diff --git a/tools/testing/selftests/iosched_ext/requeue_without_fallback_bypass.sh b/tools/testing/selftests/iosched_ext/requeue_without_fallback_bypass.sh
new file mode 100755
index 000000000..000000000
--- /dev/null
+++ b/tools/testing/selftests/iosched_ext/requeue_without_fallback_bypass.sh
@@ -0,0 +1,57 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+
+KSFT_PASS=0
+KSFT_FAIL=1
+
+self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+src="${IOSCHED_EXT_SRC:-$self_dir/../../../../block/iosched_ext.c}"
+
+if [ ! -r "$src" ]; then
+	echo "1..1"
+	echo "not ok 1 iosched_ext.c is readable"
+	exit "$KSFT_FAIL"
+fi
+
+awk '
+BEGIN {
+	print "1..1"
+}
+
+/^static void scx_io_requeue_without_fallback\(/ {
+	in_requeue = 1
+}
+in_requeue && /rq->rq_flags[[:space:]]*&=[[:space:]]*~RQF_USE_SCHED;/ {
+	clears_use_sched = 1
+}
+in_requeue && /blk_mq_requeue_request\(/ {
+	calls_requeue = 1
+}
+in_requeue && /blk_mq_request_bypass_insert\(/ {
+	calls_bypass_insert = 1
+}
+in_requeue && /blk_mq_run_hw_queue\(/ {
+	calls_run_hw_queue = 1
+}
+in_requeue && /^}/ {
+	in_requeue = 0
+}
+
+END {
+	if (clears_use_sched && !calls_requeue && calls_bypass_insert && calls_run_hw_queue) {
+		print "ok 1 requeue_without_fallback uses direct bypass insert"
+		exit 0
+	}
+
+	print "not ok 1 requeue_without_fallback uses direct bypass insert"
+	if (!clears_use_sched)
+		print "# scx_io_requeue_without_fallback does not clear RQF_USE_SCHED"
+	if (calls_requeue)
+		print "# scx_io_requeue_without_fallback still calls blk_mq_requeue_request"
+	if (!calls_bypass_insert)
+		print "# scx_io_requeue_without_fallback does not call blk_mq_request_bypass_insert"
+	if (!calls_run_hw_queue)
+		print "# scx_io_requeue_without_fallback does not kick the hw queue"
+	exit 1
+}
+' "$src"
diff --git a/tools/testing/selftests/iosched_ext/toctou_atomic_dec.sh b/tools/testing/selftests/iosched_ext/toctou_atomic_dec.sh
new file mode 100755
index 000000000..000000000
--- /dev/null
+++ b/tools/testing/selftests/iosched_ext/toctou_atomic_dec.sh
@@ -0,0 +1,123 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+
+KSFT_PASS=0
+KSFT_FAIL=1
+
+self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+src="${IOSCHED_EXT_SRC:-$self_dir/../../../../block/iosched_ext.c}"
+
+if [ ! -r "$src" ]; then
+	echo "1..1"
+	echo "not ok 1 iosched_ext.c is readable"
+	exit "$KSFT_FAIL"
+fi
+
+awk '
+function brace_delta(line,    text, opens, closes) {
+	text = line
+	opens = gsub(/\{/, "", text)
+	text = line
+	closes = gsub(/\}/, "", text)
+	return opens - closes
+}
+
+function enter_function(name, line) {
+	func = name
+	depth = brace_delta(line)
+}
+
+function leave_function() {
+	func = ""
+	depth = 0
+}
+
+BEGIN {
+	print "1..1"
+}
+
+/^static bool scx_io_blkg_note_bpf_complete\(/ {
+	pending = "complete"
+}
+/^static void scx_io_note_bpf_dispatch\(/ {
+	pending = "dispatch"
+}
+/^static noinline void scx_io_policy_note_dispatch\(/ {
+	pending = "policy"
+}
+
+pending && /\{/ {
+	enter_function(pending, $0)
+	pending = ""
+	next
+}
+
+func == "complete" {
+	if (/atomic_dec_if_positive\(&scx_pd->bpf_in_flight\)/)
+		complete_uses_dec_if_positive = 1
+	if (/atomic_read\(&scx_pd->bpf_in_flight\)/)
+		complete_reads_inflight = 1
+	if (/atomic_dec_return\(&scx_pd->bpf_in_flight\)/)
+		complete_old_dec_return = 1
+	if (/atomic_dec\(&scx_pd->bpf_in_flight\)/)
+		complete_old_dec = 1
+}
+
+func == "dispatch" {
+	if (/scx_io_blkg_note_bpf_complete\(data, blkg\)/)
+		dispatch_gates_on_complete = 1
+	if (/atomic_dec_if_positive\(&data->bpf_in_flight\)/)
+		dispatch_uses_dec_if_positive = 1
+	if (/atomic_read\(&data->bpf_in_flight\)/)
+		dispatch_reads_inflight = 1
+	if (/atomic_dec_return\(&data->bpf_in_flight\)/)
+		dispatch_old_dec_return = 1
+	if (/atomic_dec\(&data->bpf_in_flight\)/)
+		dispatch_old_dec = 1
+}
+
+func == "policy" {
+	if (/atomic_dec_if_positive\(&policy->managed_inflight\)/)
+		policy_uses_dec_if_positive = 1
+	if (/atomic_read\(&policy->managed_inflight\)/)
+		policy_reads_inflight = 1
+	if (/atomic_dec_return\(&policy->managed_inflight\)/)
+		policy_old_dec_return = 1
+	if (/atomic_dec\(&policy->managed_inflight\)/)
+		policy_old_dec = 1
+}
+
+func {
+	depth += brace_delta($0)
+	if (depth == 0)
+		leave_function()
+}
+
+END {
+	if (complete_uses_dec_if_positive && !complete_reads_inflight &&
+	    !complete_old_dec_return && !complete_old_dec &&
+	    dispatch_gates_on_complete && dispatch_uses_dec_if_positive &&
+	    !dispatch_reads_inflight && !dispatch_old_dec_return &&
+	    !dispatch_old_dec && policy_uses_dec_if_positive &&
+	    !policy_reads_inflight && !policy_old_dec_return &&
+	    !policy_old_dec) {
+		print "ok 1 iosched_ext inflight dispatch counters use atomic_dec_if_positive"
+		exit 0
+	}
+
+	print "not ok 1 iosched_ext inflight dispatch counters use atomic_dec_if_positive"
+	if (!complete_uses_dec_if_positive)
+		print "# scx_io_blkg_note_bpf_complete does not use atomic_dec_if_positive for scx_pd->bpf_in_flight"
+	if (complete_reads_inflight || complete_old_dec_return || complete_old_dec)
+		print "# scx_io_blkg_note_bpf_complete still has a read-then-decrement pattern for scx_pd->bpf_in_flight"
+	if (!dispatch_gates_on_complete || !dispatch_uses_dec_if_positive)
+		print "# scx_io_note_bpf_dispatch does not gate atomic_dec_if_positive on per-blkg completion"
+	if (dispatch_reads_inflight || dispatch_old_dec_return || dispatch_old_dec)
+		print "# scx_io_note_bpf_dispatch still has a read-then-decrement pattern for data->bpf_in_flight"
+	if (!policy_uses_dec_if_positive)
+		print "# scx_io_policy_note_dispatch does not use atomic_dec_if_positive for policy->managed_inflight"
+	if (policy_reads_inflight || policy_old_dec_return || policy_old_dec)
+		print "# scx_io_policy_note_dispatch still has a read-then-decrement pattern for policy->managed_inflight"
+	exit 1
+}
+' "$src"
