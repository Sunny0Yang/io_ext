diff --git a/include/linux/d2fq.h b/include/linux/d2fq.h
new file mode 100644
index 000000000..000000000
--- /dev/null
+++ b/include/linux/d2fq.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_D2FQ_H
+#define _LINUX_D2FQ_H
+
+/*
+ * D2FQ: Device-Direct Fair Queueing for NVMe SSDs (Woo, Ahn, Lee, Jeong;
+ * FAST'21) — ported from the open-source reference kernel
+ * (skkucsl/d2fq, Linux 5.3.10) into the
+ * ioext 7.x tree.
+ *
+ * Declared deviations from the reference (same discipline as the homo-v2
+ * x_d2fq_arb deviation list in arb_d2fq.bpf.c):
+ *  1. O_D2FQ moved from the reference's 040000000 (bit 26) to 0200000000
+ *     (bit 27): in the modern tree bit 26 is the internal O_EMPTYPATH.
+ *  2. PF_D2FQ moved from 0x20000000 to 0x40000000 (which is a PF__HOLE in
+ *     the modern tree; 0x20000000 is now PF_BLOCK_TS).
+ *  3. CONFIG_IOSCHED_D2FQ_MULTISQ (three SQs per CQ pair) is NOT ported:
+ *     it needs the device SQ count = cores*3 class-rotation scheme.  Only
+ *     the single-SQ-per-priority-rotation non-MULTISQ variant is ported.
+ *  4. d2fq_sysctl "d2fq_force_all" (debug, default 0): when set, request
+ *     classification applies to every task, not only tasks with PF_D2FQ
+ *     (tasks that opened files with O_D2FQ).  The rig drives this knob
+ *     because stock fio cannot pass a custom open() flag.  Reference
+ *     election (PF_D2FQ on O_D2FQ reads/writes) remains fully implemented.
+ *  5. Reference bug fixes: d2fq_assign_dd() no longer GFP-kmallocs while
+ *     holding the group_leader spinlock (sleeping under spinlock); queue
+ *     teardown frees the d2fq_global_data and destroys the kd2fqd
+ *     workqueue (the reference leaks both); workqueue allocation failure
+ *     degrades to disabled d2fq instead of panic().
+ */
+
+#include <linux/types.h>
+
+#ifdef CONFIG_IOSCHED_D2FQ
+
+enum{
+	D2FQ_CLS_HIGH	= 1,
+	D2FQ_CLS_MEDIUM	= 2,
+	D2FQ_CLS_LOW	= 3,
+	RNG_D2FQ_CLS	= 4,
+};
+
+struct request_queue;
+struct task_struct;
+struct d2fq_data;
+struct d2fq_global_data;
+
+/* sysfs queue/d2fq_en helpers (implemented in block/d2fq.c, wired in
+ * block/blk-sysfs.c) */
+ssize_t queue_d2fq_en_show(struct request_queue *q, char *page);
+ssize_t queue_d2fq_en_store(struct request_queue *q, const char *page,
+			    size_t count);
+
+void exit_d2fq(struct task_struct *task);
+int __d2fq_start_request(struct d2fq_data *dd);
+void __d2fq_update_vt(struct d2fq_data *dd, unsigned cls, unsigned dlen);
+void d2fq_init_dgd(struct request_queue *q);
+void d2fq_exit_dgd(struct request_queue *q);
+struct d2fq_data* d2fq_assign_dd(void *dgd);
+struct d2fq_data* d2fq_flow_for_queue(struct request_queue *q);
+
+/* declared deviation 4 (debug, default 0): bypass O_D2FQ election */
+extern unsigned int sysctl_d2fq_force_all;
+
+/* O_D2FQ task election: read/write/fsync paths on a file opened with
+ * O_D2FQ mark the task (and its group leader) with PF_D2FQ for the
+ * duration of the I/O (reference fs/read_write.c etc. hooks). */
+static inline void d2fq_task_mark(struct task_struct *tsk)
+{
+	WRITE_ONCE(tsk->flags, tsk->flags | PF_D2FQ);
+	if (tsk->group_leader)
+		WRITE_ONCE(tsk->group_leader->flags,
+			   tsk->group_leader->flags | PF_D2FQ);
+}
+static inline void d2fq_task_unmark(struct task_struct *tsk)
+{
+	WRITE_ONCE(tsk->flags, tsk->flags & ~PF_D2FQ);
+	if (tsk->group_leader)
+		WRITE_ONCE(tsk->group_leader->flags,
+			   tsk->group_leader->flags & ~PF_D2FQ);
+}
+
+#else /* CONFIG_IOSCHED_D2FQ */
+
+static inline void d2fq_task_mark(struct task_struct *tsk) { }
+static inline void d2fq_task_unmark(struct task_struct *tsk) { }
+
+#endif /* CONFIG_IOSCHED_D2FQ */
+#endif /* _LINUX_D2FQ_H */
