+		.data		= &sysctl_d2fq_write_weight,
+		.maxlen		= sizeof(sysctl_d2fq_write_weight),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_thrsh",
+		.data		= &sysctl_d2fq_thrsh,
+		.maxlen		= sizeof(sysctl_d2fq_thrsh),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_cls_base",
+		.data		= &sysctl_d2fq_cls_base,
+		.maxlen		= sizeof(sysctl_d2fq_cls_base),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_md_ratio",
+		.data		= &sysctl_d2fq_md_ratio,
+		.maxlen		= sizeof(sysctl_d2fq_md_ratio),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_di_period",
+		.data		= &sysctl_d2fq_di_period,
+		.maxlen		= sizeof(sysctl_d2fq_di_period),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_dw_en",
+		.data		= &sysctl_d2fq_dw_en,
+		.maxlen		= sizeof(sysctl_d2fq_dw_en),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_dw_period",
+		.data		= &sysctl_d2fq_dw_period,
+		.maxlen		= sizeof(sysctl_d2fq_dw_period),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+	{
+		.procname	= "d2fq_force_all",
+		.data		= &sysctl_d2fq_force_all,
+		.maxlen		= sizeof(sysctl_d2fq_force_all),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec,
+	},
+};
+
+/* NOTE (7.x API parity): the sysctl walker iterates exactly
+ * array_size(table) entries — the 5.3-era `{ }`-sentinel terminating entry
+ * of the reference is NOT allowed here (it is checked as a null-procname
+ * entry and the whole registration fails).  No sentinel in the table. */
+static int __init d2fq_init(void)
+{
+	register_sysctl_init("kernel", d2fq_sysctl_table);
+	return 0;
+}
+/* late_initcall matches the in-tree kernel/ sysctl-registration precedents
+ * (sched_rt, delayacct): core_initcall ran before the sysctl directory
+ * infrastructure (fs_initcall) and the table failed to register. */
+late_initcall(d2fq_init);
+
+#endif /* CONFIG_IOSCHED_D2FQ */
