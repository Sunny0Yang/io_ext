#!/usr/bin/env bpftrace
/*
 * m1_pattern_sampler.bt — M1 solo load-pattern per-request sampler (P0-2 / M1).
 *
 * Purpose (docs/plans/paper_motivation_design.md §3.4 six axes + prompt B):
 * per-request sampling of (ts_ns, RW, nr_bytes, arrival->complete latency)
 * for block-layer requests, plus exact in-kernel aggregates for the axes that
 * must not depend on printf throughput:
 *
 *   1 size distribution       — per-direction lhist at issue (exact `bytes`)
 *                                + thinned per-request dump
 *   2 byte bimodality          — >64KB byte share from byte sums + lhist
 *   3 direction byte ratio     — @m1_bytes_r / @m1_bytes_w (issue-side sums)
 *   4 concurrency proxy        — ib_system_metric 1 Hz /proc/diskstats
 *                                ios_in_progress (NOT probed here: in-probe
 *                                scalar counters cannot track cross-CPU
 *                                issue/complete balance — verified
 *                                empirically 2026-10-20, see dweller.bt
 *                                header note)
 *   5 barrier rate             — @m1_flush_issue_count (REQ_OP_FLUSH/s)
 *   6 arrival non-stationarity — @m1_sec_start[] / @m1_sec_comp[] exact
 *                                per-second counts (IOPS CV)
 *   7 direct-I/O ratio         — scene config metadata (not measurable here)
 *
 * Dump protocol (thinned 1-in-16 at completion; racy scalar counter is fine
 * for uniform thinning; 1/16 keeps async printf well below bpftrace's loss
 * threshold at the observed ~114k IOPS QD256 rate):
 *   M1P <arr_ts_ns> <opcode> <nr_bytes> <e2e_ns> <comp_ts_ns> <anchor>
 *     opcode: 0=R, 1=W, 2=REQ_OP_FLUSH, 3=discard, 4=other, 5=W+REQ_PREFLUSH
 *     anchor: 1=first block_rq_insert ts, 2=block_io_start ts
 *
 * Clock anchor (for slicing phases in wall time):
 *   M1BEGIN_BOOTNS <nsecs> + M1BEGIN_EPOCH <epoch-s>   (printed at BEGIN)
 *
 * DIALECT + PAIRING DISCIPLINE (learned the hard way tonight, see M1 RUN_LOG
 * 2026-10-29):
 *   - This VM's bpftrace is v0.20.2 (shared host rootfs). The `let @m =
 *     hash(N)` map-declaration dialect used by block_io_latency_cost.bt /
 *     dweller.bt / block_mq_latency.bt does NOT parse here ("syntax error,
 *     unexpected map, expecting {") and has silently broken all three in
 *     every vng rig run (their scenes run with require_events=false). The
 *     plain dialect is used; script config blocks for max_map_keys are not
 *     accepted by this build either, so anchor maps live within the default
 *     4096-key cap (see key discipline below).
 *   - Tracepoint char arrays surface as string[10]: rwbs[0] indexing and
 *     str(rwbs) are rejected; strcontains() + an nr_sector discriminator are
 *     used instead.
 *   - EMPIRICAL (M1_FIO_smoke, QD256 randread on `none`): block_rq_insert
 *     NEVER fires (0 of 2.28M issues) — the direct-issue path bypasses the
 *     insert tracepoint even at queue depth 256. So the insert-only anchor
 *     would leave solo runs (all `none`) with zero latency samples. Anchor
 *     priority: first block_rq_insert ts, else block_io_start ts (request
 *     creation, fires universally — verified start_count == issue_count).
 *   - Anchor key = (dev, sector) ONLY: the start sector is invariant under
 *     back merges, so bio-merge-grown requests still find their creation
 *     anchor (the nr_sector component would break the key, dweller's
 *     "key mismatch" class). Leak sources are then limited to front merges
 *     (rare) and same-key flush collisions; outstanding depth (~QD) keeps
 *     the map far below the default 4096-key cap. Per-run coverage is
 *     reported via @m1_anchored_count / @m1_anchor_missing_count; size axes
 *     come from the unbiased issue-side lhist + byte sums regardless.
 *   - bpftrace cannot mix keyless and keyed entries in one map: keyless
 *     totals and keyed per-second counts live in separate maps.
 *
 * rwbs decoding verified against linux-7.0 kernel/trace/blktrace.c
 * blk_fill_rwbs(): 'W' only appears for write-op requests (preflush data
 * writes print "FW...", FUA writes "WF..."); 'R' only for reads. REQ_OP_FLUSH
 * = 'F'-containing rwbs with zero data sectors ("F"/"FS" carry no bytes;
 * preflush data writes "FW..." have nr_sector > 0).
 */

BEGIN
{
  printf("M1_SAMPLER_START\n");
  printf("M1BEGIN_BOOTNS %llu\n", nsecs);
  time("M1BEGIN_EPOCH %s\n");
  printf("tracepoints=block_io_start,block_rq_insert,block_rq_issue,block_rq_complete\n");
  printf("dump=M1P arr_ts_ns opcode nr_bytes e2e_ns comp_ts_ns anchor\n");
  printf("opcode=0:R,1:W,2:flush_op,3:discard,4:other,5:preflush_write anchor=1:insert,2:start\n");
  printf("sample_every=16\n");
}

tracepoint:block:block_io_start
{
  $d = args->dev;
  $s = args->sector;
  @m1_start_count = count();
  @m1_sec_start[(uint64)(nsecs / 1000000000)] = count();
  // Key = (dev, sector) only: start sector is invariant under BACK merges
  // (the dominant merge direction), so a request grown by bio merges still
  // finds its creation anchor at completion. nr_sector would change per
  // merge and strand the anchor (dweller's "key mismatch" class).
  if (!@m1_start_ns[$d, $s]) {
    @m1_start_ns[$d, $s] = nsecs;
  }
}

tracepoint:block:block_rq_insert
{
  $d = args->dev;
  $s = args->sector;
  @m1_ins_count = count();
  if (!@m1_ins_ns[$d, $s]) {
    @m1_ins_ns[$d, $s] = nsecs;
    @m1_first_ins_count = count();
  }
}

tracepoint:block:block_rq_issue
{
  $b = args->bytes;
  @m1_issue_count = count();

  // Direction byte sums + size lhist (issue-side `bytes` is exact).
  if (strcontains(args->rwbs, "W")) {
    @m1_bytes_w = sum($b);
    @m1_size_w = lhist($b, 0, 1048576, 4096);
  } else {
    if (strcontains(args->rwbs, "R")) {
      @m1_bytes_r = sum($b);
      @m1_size_r = lhist($b, 0, 1048576, 4096);
    } else {
      @m1_bytes_other = sum($b);
    }
  }

  // REQ_OP_FLUSH events (barrier axis 5). Exact per-second flush counts:
  // flush sequence requests are created by the block layer itself and fire
  // NEITHER block_rq_insert NOR block_io_start (verified on M1_SHORE_qps50
  // 2026-10-29: 68.6k flushes at issue, zero per-request dump anchors) — so
  // the windowed flush rate MUST come from this exact per-second map.
  if (strcontains(args->rwbs, "F")) {
    if (args->nr_sector == 0) {
      @m1_flush_issue_count = count();
      @m1_sec_flush[(uint64)(nsecs / 1000000000)] = count();
    }
  }
}

tracepoint:block:block_rq_complete
{
  $d = args->dev;
  $s = args->sector;
  $n = args->nr_sector;
  $now = nsecs;
  @m1_complete_count = count();
  $sec = (uint64)($now / 1000000000);

  // opcode decode from complete-side rwbs (kernel 7.0 has rwbs here).
  $op = 4;
  if (strcontains(args->rwbs, "W")) {
    $op = 1;
  } else {
    if (strcontains(args->rwbs, "R")) {
      $op = 0;
    } else {
      if (strcontains(args->rwbs, "F")) {
        if (args->nr_sector == 0) {
          $op = 2;
        } else {
          $op = 5;
        }
      } else {
        if (strcontains(args->rwbs, "D")) {
          $op = 3;
        }
      }
    }
  }

  @m1_sec_comp[$sec] = count();
  if ($op == 0) {
    @m1_sec_comp_r[$sec] = count();
  }
  if ($op == 1 || $op == 5) {
    @m1_sec_comp_w[$sec] = count();
  }

  // arrival->complete latency: first insert anchor, else request-creation
  // (block_io_start) anchor for the direct-issue/bypass path.
  $nb = (uint64)$n * 512;
  $anchor = 0;
  $ats = @m1_ins_ns[$d, $s];
  if ($ats) {
    $anchor = 1;
  } else {
    $ats = @m1_start_ns[$d, $s];
    if ($ats) {
      $anchor = 2;
    }
  }

  if ($anchor) {
    $e2e = $now - $ats;
    @m1_lat_ns = stats($e2e);
    @m1_anchored_count = count();
    if ($anchor == 1) {
      @m1_ins_anchor_count = count();
    } else {
      @m1_start_anchor_count = count();
    }
    $sq = @m1_seq;
    @m1_seq = ($sq + 1) % 16;
    if ($sq == 0) {
      printf("M1P %llu %llu %llu %llu %llu %llu\n", $ats, $op, $nb, $e2e, $now, $anchor);
      @m1_dump_count = count();
    }
  } else {
    @m1_anchor_missing_count = count();
  }
  delete(@m1_ins_ns[$d, $s]);
  delete(@m1_start_ns[$d, $s]);
}

END
{
  printf("M1_SAMPLER_SUMMARY_BEGIN\n");
  print(@m1_start_count);
  print(@m1_ins_count);
  print(@m1_first_ins_count);
  print(@m1_issue_count);
  print(@m1_complete_count);
  print(@m1_flush_issue_count);
  print(@m1_bytes_r);
  print(@m1_bytes_w);
  print(@m1_bytes_other);
  print(@m1_size_r);
  print(@m1_size_w);
  print(@m1_lat_ns);
  print(@m1_anchored_count);
  print(@m1_ins_anchor_count);
  print(@m1_start_anchor_count);
  print(@m1_anchor_missing_count);
  print(@m1_dump_count);
  printf("M1_SAMPLER_SUMMARY_END\n");
  // Per-second exact counts (parsed from this log by the metrics script).
  print(@m1_sec_start);
  print(@m1_sec_comp);
  print(@m1_sec_comp_r);
  print(@m1_sec_comp_w);
  print(@m1_sec_flush);
  // Prevent bpftrace's exit auto-print from re-dumping the anchor maps.
  clear(@m1_ins_ns);
  clear(@m1_start_ns);
  clear(@m1_seq);
}