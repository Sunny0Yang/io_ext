# =========================================================================
# experiments/reproduction / linnos / fio_none_lc.fio
# 实验8 LinnOS：none 臂 LC 侧。LC 4k randread QD32 稳定 120s（[PLAN] linnos
# 固定项 + [MSC] 120s 分 4 段口径；LC 是稳定流，单 job 连续）。
# 实验臂集：none / iox（Native N/A：无可对照参考实现，OSDI'20 在线 NN 无法
# 同态复现 —— D2FQ_NATIVE_PORT_20261110.md "LinnOS：native 不可行的原因"）。
# 日志命名：linnos_iox_lc
# =========================================================================
[global]
ioengine=libaio
direct=1
time_based=1
group_reporting=1
percentile_list=50:90:95:99:99.9
log_avg_msec=500
numjobs=1
randrepeat=0
norandommap=1
filename=/data/lc.bin

[lc]
rw=randread
bs=4k
iodepth=32
runtime=120
ramp_time=5
randseed=2026111400
write_lat_log=linnos_iox_lc
write_bw_log=linnos_iox_lc
write_iops_log=linnos_iox_lc
